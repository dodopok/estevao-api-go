# Environment shared by the Rails oracle and the Go server under test.
RAILS_ENV=production
SECRET_KEY_BASE=oracle-secret-key-base-not-a-real-secret
DATABASE_URL=postgres://postgres:postgres@localhost:5432/estevao_api_development
REDIS_URL=redis://localhost:6379/1
FIREBASE_PROJECT_ID=estevao-test
DEVELOPER_FIREBASE_PROJECT_ID=estevao-dev-test
APP_INTERNAL_IDENTIFIER=test-app-internal-id
DASHBOARD_ADMIN_EMAIL=admin@example.com
TRUSTED_SERVER_KEY=trusted-server-test-key
TRUSTED_SERVER_RATE_LIMIT=1000000
NEW_RELIC_AGENT_ENABLED=false
RAILS_LOG_LEVEL=warn
AVATAR_BUCKET_NAME=test-avatars
AVATAR_BUCKET_ACCESS_KEY_ID=test
AVATAR_BUCKET_SECRET_ACCESS_KEY=test
AVATAR_BUCKET_REGION=auto
AVATAR_BUCKET_ENDPOINT=http://127.0.0.1:9000
