# Environment shared by the Rails oracle and the Go server under test.
RAILS_ENV=production
SECRET_KEY_BASE=oracle-secret-key-base-not-a-real-secret
DATABASE_URL=postgres://postgres:postgres@localhost:5432/estevao_api_development
REDIS_URL=redis://localhost:6379/1
FIREBASE_PROJECT_ID=estevao-test
DEVELOPER_FIREBASE_PROJECT_ID=estevao-dev-test
APP_INTERNAL_IDENTIFIER=test-app-internal-id
DASHBOARD_ADMIN_EMAIL=admin@example.com
TRUSTED_SERVER_KEY=trusted-server-test-key
TRUSTED_SERVER_RATE_LIMIT=1000000
NEW_RELIC_AGENT_ENABLED=false
RAILS_LOG_LEVEL=warn
AVATAR_BUCKET_NAME=test-avatars
AVATAR_BUCKET_ACCESS_KEY_ID=test
AVATAR_BUCKET_SECRET_ACCESS_KEY=test
AVATAR_BUCKET_REGION=auto
AVATAR_BUCKET_ENDPOINT=http://127.0.0.1:9000
# Firebase Admin (account deletion) against test/oracle/fake_google.py.
FIREBASE_CLIENT_EMAIL=fake-admin@estevao-test.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="$(cat "$(dirname "${BASH_SOURCE[0]}")/test_firebase_key.pem")"
ORACLE_FAKE_GOOGLE_URL=http://127.0.0.1:3998
FIREBASE_OAUTH_TOKEN_URL=http://127.0.0.1:3998/token
FIREBASE_IDENTITY_TOOLKIT_URL=http://127.0.0.1:3998
# RevenueCat against the same fake (oracle.ru rewrites the http.rb URL).
REVENUECAT_API_KEY=rc-test-key
REVENUECAT_API_URL=http://127.0.0.1:3998/revenuecat/v1
# Perplexity against the same fake.
PERPLEXITY_API_KEY=px-test-key
PERPLEXITY_API_URL=http://127.0.0.1:3998/perplexity
# Strapi (rosary publication) against the same fake.
STRAPI_API_URL=http://127.0.0.1:3998/strapi
ROSARY_INTERNAL_TOKEN=strapi-internal-test
STRAPI_API_TOKEN=strapi-read-test
FCM_API_URL=http://127.0.0.1:3998
FIREBASE_CREDENTIALS="$(python3 -c 'import json, sys; print(json.dumps({"type": "service_account", "project_id": "estevao-test", "client_email": "fake-admin@estevao-test.iam.gserviceaccount.com", "private_key": open(sys.argv[1]).read(), "token_uri": "https://oauth2.googleapis.com/token"}))' "$(dirname "${BASH_SOURCE[0]}")/test_firebase_key.pem")"
STRIPE_SECRET_KEY=sk_test_fake
STRIPE_WEBHOOK_SECRET=whsec_test
STRIPE_API_URL=http://127.0.0.1:3998/stripe/v1
PORTAL_BASE_URL=https://portal.example.test
STRIPE_PRICE_PARISH_MONTH_BRL=price_parish_month_brl
STRIPE_PRICE_DIOCESE_YEAR_USD=price_diocese_year_usd
STRIPE_PRICE_PROVINCE_MONTH_BRL=price_bad
# Speech providers (audio generation jobs) against the same fake.
OPENAI_API_KEY=sk-openai-test
OPENAI_API_URL=http://127.0.0.1:3998/openai
GOOGLE_TTS_API_URL=http://127.0.0.1:3998/google-tts
ELEVENLABS_API_KEY=eleven-test-key
ELEVENLABS_API_URL=http://127.0.0.1:3998/elevenlabs
